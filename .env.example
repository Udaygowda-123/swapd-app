# Copy to .env.local (git-ignored). Restart `npx expo start` after changing it.
#
# Which SWAPD API the app talks to. Default (when unset): the live site, https://barter-web-wheat.vercel.app
# To test against your laptop's local web app (`pnpm dev` in barter/), use your laptop's Wi-Fi IP — not
# "localhost", which on a phone means the phone itself:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
