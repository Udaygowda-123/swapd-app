{
  "expo": {
    "name": "SWAPD",
    "slug": "swapd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "swapd",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF8F5",
    "ios": {
      "bundleIdentifier": "com.swapd.app",
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.swapd.app",
      "adaptiveIcon": {
        "backgroundColor": "#FF765E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF765E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "SWAPD uses your photos so you can add pictures of items you list.",
          "cameraPermission": "SWAPD uses the camera so you can photograph items you list.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SWAPD uses your approximate location (rounded to about 10 km) to show nearby items. Only your city is ever shown to others."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "04b30ab0-0ae3-4eb1-9505-af56eb1c6d32"
      }
    },
    "owner": "udayrgowda123"
  }
}
